{
  "name": "cc5003-solotono",
  "version": "2.0.0",
  "description": "SoloTono: Agregador de instrumentos musicales, comparación de ofertas y seguimiento de precios (estilo SoloTodo)",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix backend install && npm --prefix frontend install && npm run scraper:setup",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "scraper:setup": "python3 -m venv scraper/.venv && scraper/.venv/bin/pip install -r scraper/requirements.txt",
    "scraper:init": "PYTHONPATH=scraper scraper/.venv/bin/python3 -m solotono init-db",
    "scraper:scrape": "PYTHONPATH=scraper scraper/.venv/bin/python3 -m solotono scrape",
    "scraper:scrape:all": "PYTHONPATH=scraper scraper/.venv/bin/python3 -m solotono scrape --all",
    "scraper:stats": "PYTHONPATH=scraper scraper/.venv/bin/python3 -m solotono stats",
    "scraper:menu": "PYTHONPATH=scraper scraper/.venv/bin/python3 -m solotono menu",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "make-admin": "npm --prefix backend run make-admin --",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "keywords": [
    "solotodo",
    "scraping",
    "instruments",
    "music",
    "price-tracking",
    "ecommerce"
  ],
  "author": "SoloTono Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
